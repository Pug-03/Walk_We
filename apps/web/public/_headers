# Security headers for static hosting that reads _headers (Cloudflare Pages,
# Netlify). On other hosts, copy these into the host's header config.
# connect-src: map tiles/styles, Photon geocoder, Open-Meteo, and the AI
# proxy (https:) — the AI Worker's own allow-list is the real gate there.
# The sha256 is the theme script inlined in index.html: update it if that script changes.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-ioJySx/qe6GI59GidNtxexjfbuhgXgRdaoqZLciWxO8='; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(), payment=(), usb=()
  X-Frame-Options: DENY

# Long-lived caching for files whose URL changes when their content does:
# hashed build output, and the walkthrough / sponsor images (requested with ?v=).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/demo/*
  Cache-Control: public, max-age=31536000, immutable
/sponsors/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=86400
