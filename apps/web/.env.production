# Copy to .env.local to override. All client-visible, never put secrets here.

# MapLibre style URLs (OpenFreeMap: free, no key).
VITE_MAP_STYLE_DAY=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_NIGHT=https://tiles.openfreemap.org/styles/dark

# Photon geocoder. The public komoot server is fair-use and meant for
# development; point production at a self-hosted Photon before launch.
VITE_GEOCODER_URL=https://photon.komoot.io

# Open-Meteo forecast API for cloud cover (free, no key).
VITE_WEATHER_URL=https://api.open-meteo.com

# Error tracking: leave empty to disable. When set, errors are POSTed here
# with any coordinates scrubbed (user location is never logged).
VITE_ERROR_TRACKING_URL=
